<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Le runtime ASP.NET Core 8.0 n'est plus installé sur cette machine (seul .NET 10 est présent) :
         on autorise le roll-forward vers une version majeure supérieure pour pouvoir exécuter l'app. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashApp.Application\CashApp.Application.csproj" />
    <ProjectReference Include="..\CashApp.Domain\CashApp.Domain.csproj" />
    <ProjectReference Include="..\CashApp.Infrastructure\CashApp.Infrastructure.csproj" />
    <ProjectReference Include="..\CashApp.Shared\CashApp.Shared.csproj" />
  </ItemGroup>

</Project>
